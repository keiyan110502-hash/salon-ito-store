# Netlify の「Site configuration > Environment variables」に登録する値（このファイル自体に本物の値は書かない）
STRIPE_SECRET_KEY=sk_test_xxx            # Stripe ダッシュボード > 開発者 > APIキー（最初はテスト用 sk_test_）
STRIPE_WEBHOOK_SECRET=whsec_xxx          # Stripe > Webhook のエンドポイント作成後に表示される署名シークレット
GAS_WEBAPP_URL=https://script.google.com/macros/s/xxxx/exec   # GAS をウェブアプリとしてデプロイしたURL
GAS_SHARED_SECRET=長いランダム文字列       # GAS のスクリプトプロパティ SHARED_SECRET と同じ値
PRODUCTS_CSV_URL=https://docs.google.com/spreadsheets/d/e/xxxx/pub?gid=0&single=true&output=csv   # 「商品」シートを「ウェブに公開」した CSV の URL
NEWS_CSV_URL=https://docs.google.com/spreadsheets/d/e/xxxx/pub?gid=1&single=true&output=csv       # 「お知らせ」シートの CSV の URL
